#!/usr/bin/env node
import { copyFileSync, lstatSync, mkdirSync, readFileSync, rmSync, writeFileSync } from 'node:fs';
import { createHash } from 'node:crypto';
import { dirname, join } from 'node:path';
import { fileURLToPath } from 'node:url';
import { HELPERS } from '../src/helpers/registry.js';
import { validateRegistry } from '../src/helpers/contract.js';

const root = fileURLToPath(new URL('../', import.meta.url));
const output = join(root, 'dist');
// Explicit shell whitelist; helper files come only from their declared runtime assets.
const files = [...new Set([
  'index.html', 'manifest.webmanifest', 'sw.js',
  'assets/styles.css', 'assets/notes.css', 'assets/signature.css', 'assets/icons/icon-192.png', 'assets/icons/icon-512.png',
  'src/app.js', 'src/db.js', 'src/schema.js', 'src/context.js', 'src/retention.js',
  'src/read-views.js', 'src/navigation.js',
  'src/notes.js', 'src/note-views.js', 'src/note-presentation.js', 'src/pwa-update.js', 'src/theme.js',
  'src/helpers/contract.js', 'src/helpers/registry.js',
  ...validateRegistry(HELPERS).flatMap(helper => [
    `src/helpers/${helper.id}/index.js`,
    ...(helper.offlineAssets || []).map(path => path.slice(2))
  ])
])].sort();

// Validate before replacing the previous output. Never follow local symlinks.
for (const file of files) {
  const parts = file.split('/');
  if (parts.some(part => !part || part === '.' || part === '..') || file.includes('\\')) {
    throw new Error(`Invalid runtime path: ${file}`);
  }
  for (let i = 1; i <= parts.length; i++) {
    if (lstatSync(join(root, ...parts.slice(0, i))).isSymbolicLink()) {
      throw new Error(`Runtime symlink: ${file}`);
    }
  }
  if (!lstatSync(join(root, file)).isFile()) throw new Error(`Missing runtime file: ${file}`);
}
// The deployed worker changes whenever a runtime file changes, even if the manual
// version bump was missed. Sorted paths + content make the release reproducible.
const digest = createHash('sha256');
for (const file of files) digest.update(file).update('\0').update(readFileSync(join(root, file))).update('\0');
const release = digest.digest('hex').slice(0, 16);
const worker = readFileSync(join(root, 'sw.js'), 'utf8');
const deployedWorker = worker.replace(/const CACHE = '(0815-[^']+)';/, (_, cache) => `const CACHE = '${cache}-${release}';`);
if (deployedWorker === worker) throw new Error('Missing worker release cache name');
rmSync(output, { recursive: true, force: true });
mkdirSync(output);
for (const file of files) {
  const target = join(output, file);
  mkdirSync(dirname(target), { recursive: true });
  copyFileSync(join(root, file), target);
}
writeFileSync(join(output, 'sw.js'), deployedWorker);
writeFileSync(join(output, '.nojekyll'), '');
console.log(`Pages: ${files.length + 1} runtime files in dist/`);
